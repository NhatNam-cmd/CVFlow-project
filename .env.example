# --- Cấu hình Flask ---
FLASK_APP=run.py
FLASK_DEBUG=1
# Các bạn tự điền key ngẫu nhiên của mình vào đây
# Để tạo key an toàn, chạy lệnh này trong terminal:
# python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change_me_please

# --- Cấu hình AI (Ollama Local) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# --- Cấu hình Database ---
DATABASE_URI=sqlite:///data/cvflow.db
