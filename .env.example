# --- CORE CONFIG ---
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=dev_secret_key_change_this_in_prod

# --- DATABASE (Sửa lại user/pass của bạn) ---
# Format: postgresql://user:password@localhost:5432/db_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/cvflow_db

# --- GOOGLE GEMINI AI ---
# Lấy key tại: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSyDxxxxxxxxx...

# --- EMAIL (Optional - Nếu dùng tính năng Reset Pass) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
