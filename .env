# --- Cấu hình Flask ---
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=khoa-bi-mat-cuc-manh-cho-dev-nam-2025

# --- Cấu hình AI (Ollama Local) ---
# Đây là địa chỉ mặc định khi bạn cài Ollama trên máy
OLLAMA_BASE_URL=http://localhost:11434

# Tên Model bạn muốn dùng (llama3, mistral, v.v...)
# Đảm bảo bạn đã chạy lệnh "ollama pull llama3" trong terminal
LLM_MODEL=llama3

# --- Cấu hình Database ---
# (Nếu không điền thì code sẽ tự dùng đường dẫn mặc định trong data/)
DATABASE_URI=sqlite:///data/cvflow.db
